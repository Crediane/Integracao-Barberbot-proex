RewriteRule ^estoque(.*)$           index.php?pag=estoque             [L,QSA]
RewriteRule ^saidas(.*)$            index.php?pag=saidas              [L,QSA]
RewriteRule ^entradas(.*)$          index.php?pag=entradas            [L,QSA]
RewriteRule ^vendas(.*)$            index.php?pag=vendas              [L,QSA]
RewriteRule ^compras(.*)$           index.php?pag=compras             [L,QSA]
RewriteRule ^pagar(.*)$             index.php?pag=pagar               [L,QSA]
RewriteRule ^receber(.*)$           index.php?pag=receber             [L,QSA]
RewriteRule ^comissoes(.*)$         index.php?pag=comissoes           [L,QSA]

RewriteRule ^agendamentos(.*)$      index.php?pag=agendamentos        [L,QSA]
RewriteRule ^servicos_agenda(.*)$   index.php?pag=servicos_agenda     [L,QSA]
RewriteRule ^marketing(.*)$         index.php?pag=marketing           [L,QSA]
RewriteRule ^cobrancas(.*)$         index.php?pag=cobrancas           [L,QSA]
RewriteRule ^pagas(.*)$             index.php?pag=pagas               [L,QSA]
RewriteRule ^textos_index(.*)$      index.php?pag=textos_index        [L,QSA]
RewriteRule ^comentarios(.*)$       index.php?pag=comentarios         [L,QSA]
RewriteRule ^agenda(.*)$            index.php?pag=agenda              [L,QSA]
RewriteRule ^meus_servicos(.*)$     index.php?pag=meus_servicos       [L,QSA]
RewriteRule ^minhas_comissoes(.*)$  index.php?pag=minhas_comissoes    [L,QSA]

RewriteRule ^dias_bloqueio_func(.*)$ index.php?pag=dias_bloqueio_func [L,QSA]
