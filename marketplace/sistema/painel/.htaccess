Options -MultiViews
RewriteEngine On

# ✅ NÃO fixe RewriteBase aqui (precisa funcionar em /sistema/painel e /loja/<slug>/painel)
# RewriteBase /sistema/painel/

# não reescrever o próprio index.php
RewriteRule ^index\.php$ - [L]



# não reescrever arquivos/pastas reais
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# home
RewriteRule ^$ index.php [L,QSA]

RewriteRule ^meus-agendamentos(.*)$ index.php?pag=meus-agendamentos [L,QSA]
RewriteRule ^grupos_disparos(.*)$   index.php?pag=grupos_disparos     [L,QSA]
RewriteRule ^whatsapp(.*)$          index.php?pag=whatsapp$1          [L,QSA]
RewriteRule ^comanda(.*)$           index.php?pag=comanda             [L,QSA]
RewriteRule ^usuarios(.*)$          index.php?pag=usuarios            [L,QSA]
RewriteRule ^funcionarios(.*)$      index.php?pag=funcionarios        [L,QSA]
RewriteRule ^marketplace_diagnostico/?$ index.php?pag=marketplace_diagnostico [L,QSA]
RewriteRule ^marketplace(.*)$       index.php?pag=marketplace         [L,QSA]

RewriteRule ^clientes_retorno(.*)$  index.php?pag=clientes_retorno    [L,QSA]
RewriteRule ^clientes(.*)$          index.php?pag=clientes            [L,QSA]

RewriteRule ^fornecedores(.*)$      index.php?pag=fornecedores        [L,QSA]
RewriteRule ^receber_vencidas(.*)$  index.php?pag=receber_vencidas    [L,QSA]

RewriteRule ^cargos(.*)$            index.php?pag=cargos              [L,QSA]
RewriteRule ^cat_servicos(.*)$      index.php?pag=cat_servicos        [L,QSA]
RewriteRule ^grupos(.*)$            index.php?pag=grupos              [L,QSA]
